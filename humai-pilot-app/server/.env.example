# Anthropic API key — from console.anthropic.com, NOT your Claude.ai Pro/Team login.
# The pilot app calls the API directly, which is billed separately from your
# Claude.ai Pro/Team seats. Keep this out of git (.env is already in .gitignore).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the backend listens on
PORT=8787

# Postgres connection string — on Render, attach a Postgres instance to this
# service and Render sets this automatically. For local testing, use your own
# local Postgres or a free hosted one (e.g. Render, Supabase, Neon).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Set this once you have your deployed Vercel frontend URL, to restrict CORS.
# Leave blank for local dev.
FRONTEND_URL=
